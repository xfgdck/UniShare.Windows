<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- ==================== 语义色（固定浅色主题，柔和色块风格） ==================== -->
    <Color x:Key="SuccessColor">#0F7B0F</Color>
    <Color x:Key="WarningColor">#9D5D00</Color>
    <Color x:Key="DangerColor">#C42B1C</Color>
    <Color x:Key="InfoColor">#005FB8</Color>
    <Color x:Key="MutedColor">#8A8A8A</Color>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>

    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#E3F4E1"/>
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#FFF4CE"/>
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#FDE7E9"/>
    <SolidColorBrush x:Key="InfoSubtleBrush" Color="#E5F1FB"/>
    <SolidColorBrush x:Key="NeutralSubtleBrush" Color="#EEEFF1"/>
    <SolidColorBrush x:Key="NeutralStrongBrush" Color="#5C5F66"/>

    <!-- 页面画布与卡片 -->
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F6F7F9"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E6E8EC"/>
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#CDD3DB"/>

    <!-- 图标色块（背景 / 前景），共享卡片按名称轮换使用 -->
    <SolidColorBrush x:Key="TileBlueBg" Color="#E5F1FB"/>
    <SolidColorBrush x:Key="TileBlueFg" Color="#005FB8"/>
    <SolidColorBrush x:Key="TileTealBg" Color="#DDF3EE"/>
    <SolidColorBrush x:Key="TileTealFg" Color="#0B7A6B"/>
    <SolidColorBrush x:Key="TileAmberBg" Color="#FCEFD9"/>
    <SolidColorBrush x:Key="TileAmberFg" Color="#9D5D00"/>
    <SolidColorBrush x:Key="TilePurpleBg" Color="#EEEBFA"/>
    <SolidColorBrush x:Key="TilePurpleFg" Color="#5B4BB7"/>
    <SolidColorBrush x:Key="TilePinkBg" Color="#FBE9F0"/>
    <SolidColorBrush x:Key="TilePinkFg" Color="#A6335E"/>

    <!-- 左侧导航栏 -->
    <SolidColorBrush x:Key="NavHoverBrush" Color="#08000000"/>

    <!-- ==================== 字号 ==================== -->
    <system:Double x:Key="PageTitleFontSize">22</system:Double>
    <system:Double x:Key="SectionTitleFontSize">15</system:Double>
    <system:Double x:Key="BodyFontSize">13</system:Double>
    <system:Double x:Key="CaptionFontSize">12</system:Double>

    <!-- ==================== 文本 ==================== -->
    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PageTitleFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SectionTitleFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FieldLabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- ==================== 容器 ==================== -->
    <!-- 白色圆角卡片 -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18,16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- 设置行：图标色块 + 标题 + 右侧控件 -->
    <Style x:Key="SettingRow" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="MinHeight" Value="64"/>
    </Style>

    <!-- 卡片内的浅色行（用户列表等） -->
    <Style x:Key="SubtleRow" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NeutralSubtleBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <!-- 卡片内分隔线 -->
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="Margin" Value="0,12"/>
    </Style>

    <!-- 圆角图标色块，Background / Foreground 由使用处指定 -->
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource TileBlueBg}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource TileBlueFg}"/>
    </Style>

    <!-- ==================== 标签 Badge ==================== -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource NeutralSubtleBrush}"/>
        <Setter Property="TextElement.FontSize" Value="11"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource NeutralStrongBrush}"/>
    </Style>

    <Style x:Key="InfoBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource InfoSubtleBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource InfoBrush}"/>
    </Style>

    <Style x:Key="WarningBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource WarningSubtleBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource WarningBrush}"/>
    </Style>

    <!-- ==================== 左侧导航项 ==================== -->
    <Style x:Key="NavListItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Height="38">
                        <ContentPresenter Margin="12,0" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource InfoSubtleBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
