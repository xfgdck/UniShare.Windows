<ui:FluentWindow x:Class="UniShare.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
        xmlns:vm="clr-namespace:UniShare.UI.ViewModels"
        xmlns:pages="clr-namespace:UniShare.UI.Views.Pages"
        Title="UniShare - 便携式文件共享服务"
        Height="640" Width="820"
        MinHeight="520" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Icon="pack://application:,,,/Assets/icon.ico"
        Closing="MainWindow_Closing">

    <ui:FluentWindow.Resources>
        <!-- 页面视图模型 → 页面视图 -->
        <DataTemplate DataType="{x:Type vm:SharesViewModel}">
            <pages:SharesPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <pages:SettingsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <pages:AboutPage/>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 系统托盘 -->
        <tray:NotifyIcon x:Name="MyNotifyIcon"
                         Icon="pack://application:,,,/Assets/icon.ico"
                         FocusOnLeftClick="True"
                         MenuOnRightClick="True"
                         TooltipText="UniShare - 文件共享服务">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="打开 UniShare" Click="TrayOpen_Click"/>
                    <Separator/>
                    <MenuItem Header="退出程序" Click="TrayExit_Click"/>
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>

        <!-- 标题栏 -->
        <Grid Grid.Row="0">
            <ui:TitleBar/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False">
                <Image Source="pack://application:,,,/Assets/icon.ico" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="UniShare" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="132"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Grid Grid.Column="0" Margin="6,8,6,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavListItem}"
                         FocusVisualStyle="{x:Null}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter/>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavigationItem}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 底部服务状态 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,0,0" DataContext="{Binding Shares}" ToolTip="{Binding StatusDetail}">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- 页面内容区 -->
            <Border Grid.Column="1"
                    Background="{StaticResource PageBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0">
                <ContentControl Content="{Binding CurrentPage}" Focusable="False"/>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
