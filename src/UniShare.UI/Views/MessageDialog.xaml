<ui:FluentWindow x:Class="UniShare.UI.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="提示"
        Width="440"
        MinHeight="190"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 顶栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 内容区 -->
            <RowDefinition Height="*"/>
            <!-- 底部按钮栏 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 极简标题栏：图标与标题紧贴最左侧 -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0">
            <ui:TitleBar x:Name="TitleBarControl" ShowMaximize="False" ShowMinimize="False"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False">
                <Image Source="pack://application:,,,/Assets/icon.ico" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock x:Name="TxtWindowCaption" Text="UniShare" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 核心内容区 -->
        <Grid x:Name="ContentGrid" Grid.Row="1" Margin="24,10,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧现代圆角状态图标徽章 -->
            <Border x:Name="IconBadge"
                    Grid.Column="0"
                    Width="42"
                    Height="42"
                    CornerRadius="12"
                    Background="#1A3B82F6"
                    VerticalAlignment="Top"
                    Margin="0,2,16,0">
                <TextBlock x:Name="TxtIconSymbol"
                           Text="i"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#3B82F6"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- 右侧标题与正文 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitle"
                           Text="提示"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtMessage"
                           Text="内容详情"
                           FontSize="13"
                           LineHeight="20"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- 底部操作按钮区 -->
        <Border x:Name="FooterBorder"
                Grid.Row="2"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="BtnCancel"
                           Content="取消"
                           Appearance="Secondary"
                           MinWidth="88"
                           Height="34"
                           Padding="16,0"
                           Margin="0,0,10,0"
                           Visibility="Collapsed"
                           Click="BtnCancel_Click"/>
                <ui:Button x:Name="BtnConfirm"
                           Content="知道了"
                           Appearance="Primary"
                           MinWidth="96"
                           Height="34"
                           Padding="18,0"
                           FontWeight="SemiBold"
                           Click="BtnConfirm_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
