<UserControl x:Class="UniShare.UI.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:UniShare.UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="24,20,24,24" MaxWidth="960">
            <TextBlock Text="关于" Style="{StaticResource PageTitleText}"/>

            <!-- 检查更新 -->
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Background="{StaticResource TilePurpleBg}"
                            TextElement.Foreground="{StaticResource TilePurpleFg}" Margin="0,0,14,0">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="14" Text="{Binding AppVersion, Mode=OneWay, StringFormat=当前版本 v{0}}"/>
                        <TextBlock Text="{Binding UpdateStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding HasNewVersion}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="前往下载" Appearance="Primary" Margin="0,0,8,0"
                                   Command="{Binding DownloadUpdateCommand}"
                                   Visibility="{Binding HasNewVersion, Converter={x:Static local:Converters.BoolToVisible}}"/>
                        <ui:Button Content="检查更新" Appearance="Secondary" Command="{Binding CheckUpdateCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 项目主页 -->
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Background="{StaticResource NeutralSubtleBrush}"
                            TextElement.Foreground="{StaticResource NeutralStrongBrush}" Margin="0,0,14,0">
                        <ui:SymbolIcon Symbol="Globe24" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="项目主页" FontSize="14" VerticalAlignment="Center"/>
                    <ui:Button Grid.Column="2" Content="打开" Icon="{ui:SymbolIcon Open24}" Appearance="Secondary"
                               VerticalAlignment="Center" Command="{Binding OpenGitHubCommand}"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
