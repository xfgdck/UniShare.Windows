<UserControl x:Class="UniShare.UI.Views.Pages.SharesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:UniShare.UI"
             xmlns:vm="clr-namespace:UniShare.UI.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="24,20,24,24" MaxWidth="960">
            <TextBlock Text="共享" Style="{StaticResource PageTitleText}"/>

            <!-- 服务状态横幅：开启为绿色，关闭为灰色，处理中为琥珀色 -->
            <Border CornerRadius="14" Padding="16" Margin="0,0,0,20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource NeutralSubtleBrush}"/>
                        <Setter Property="TextElement.Foreground" Value="{StaticResource NeutralStrongBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Background" Value="{StaticResource SuccessSubtleBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Background" Value="{StaticResource WarningSubtleBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{StaticResource WarningBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="48" Height="48" CornerRadius="14" Background="#B3FFFFFF" Margin="0,0,16,0">
                        <ui:SymbolIcon FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="WifiOff24"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Symbol" Value="Wifi124"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Symbol" Value="ArrowSync24"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatusDetail}" FontSize="13" Opacity="0.85" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ui:Button Grid.Column="2"
                               Content="{Binding ToggleButtonText}"
                               Command="{Binding ToggleServerCommand}"
                               MinWidth="104" Height="36" Margin="16,0,0,0"
                               VerticalAlignment="Center">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Primary"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Appearance" Value="Secondary"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </Grid>
            </Border>

            <!-- 共享目录卡片：灰色表头（标题、数量、新建）+ 白色列表行 -->
            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Border CornerRadius="11,11,0,0" Padding="16,8" Background="{StaticResource PageBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid MinHeight="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="共享目录" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="9" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasShares, Converter={x:Static local:Converters.BoolToVisible}}">
                                <TextBlock Text="{Binding ShareCount}" Style="{StaticResource CaptionText}"/>
                            </Border>
                            <ui:Button Grid.Column="3" Content="新建共享" Icon="{ui:SymbolIcon Add24}" Appearance="Transparent"
                                       Foreground="{StaticResource InfoBrush}" Padding="8,5" VerticalAlignment="Center"
                                       Command="{Binding AddShareCommand}"
                                       Visibility="{Binding HasShares, Converter={x:Static local:Converters.BoolToVisible}}"/>
                        </Grid>
                    </Border>

                    <!-- 空状态 -->
                    <StackPanel HorizontalAlignment="Center" Margin="24,32"
                                Visibility="{Binding HasShares, Converter={x:Static local:Converters.InverseBoolToVisible}}">
                        <Border Style="{StaticResource IconTile}" Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="FolderAdd24" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="新建你的第一个共享" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="选一个文件夹，局域网里的手机、电视和电脑就能直接访问"
                                   Style="{StaticResource CaptionText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,18"/>
                        <ui:Button Content="新建共享" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                                   HorizontalAlignment="Center" Padding="20,8"
                                   Command="{Binding AddShareCommand}"/>
                    </StackPanel>

                <ItemsControl ItemsSource="{Binding Items}" AlternationCount="2147483647"
                              Visibility="{Binding HasShares, Converter={x:Static local:Converters.BoolToVisible}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ShareItemViewModel}">
                            <Border Padding="16,12" BorderThickness="0,1,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Margin="0,0,14,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource IconTile}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TileIndex}" Value="1">
                                                        <Setter Property="Background" Value="{StaticResource TileTealBg}"/>
                                                        <Setter Property="TextElement.Foreground" Value="{StaticResource TileTealFg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TileIndex}" Value="2">
                                                        <Setter Property="Background" Value="{StaticResource TileAmberBg}"/>
                                                        <Setter Property="TextElement.Foreground" Value="{StaticResource TileAmberFg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TileIndex}" Value="3">
                                                        <Setter Property="Background" Value="{StaticResource TilePurpleBg}"/>
                                                        <Setter Property="TextElement.Foreground" Value="{StaticResource TilePurpleFg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TileIndex}" Value="4">
                                                        <Setter Property="Background" Value="{StaticResource TilePinkBg}"/>
                                                        <Setter Property="TextElement.Foreground" Value="{StaticResource TilePinkFg}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ui:SymbolIcon Symbol="Folder24" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding LocalPath}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding LocalPath}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource InfoBadge}"
                                                Visibility="{Binding IsReadOnly, Converter={x:Static local:Converters.InverseBoolToVisible}}">
                                            <TextBlock Text="可读写"/>
                                        </Border>
                                        <Border Style="{StaticResource Badge}"
                                                Visibility="{Binding IsReadOnly, Converter={x:Static local:Converters.BoolToVisible}}">
                                            <TextBlock Text="只读"/>
                                        </Border>
                                        <Border Style="{StaticResource WarningBadge}"
                                                Visibility="{Binding AllowGuest, Converter={x:Static local:Converters.BoolToVisible}}">
                                            <TextBlock Text="匿名访问"/>
                                        </Border>
                                        <Border Style="{StaticResource Badge}"
                                                Visibility="{Binding EnableSmb1, Converter={x:Static local:Converters.BoolToVisible}}">
                                            <TextBlock Text="兼容旧设备"/>
                                        </Border>
                                    </StackPanel>

                                    <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon MoreHorizontal24}" Appearance="Transparent" ToolTip="更多操作"
                                               Padding="8,6" VerticalAlignment="Center" Margin="8,0,0,0" Click="MoreButton_Click">
                                        <ui:Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="打开文件夹" Command="{Binding OpenFolderCommand}">
                                                    <MenuItem.Icon>
                                                        <ui:SymbolIcon Symbol="FolderOpen24"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="编辑共享" Command="{Binding EditCommand}">
                                                    <MenuItem.Icon>
                                                        <ui:SymbolIcon Symbol="Edit24"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="移除共享" Command="{Binding RemoveCommand}">
                                                    <MenuItem.Icon>
                                                        <ui:SymbolIcon Symbol="Delete24"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </ui:Button.ContextMenu>
                                    </ui:Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
