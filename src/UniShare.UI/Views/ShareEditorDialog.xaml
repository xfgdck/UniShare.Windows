<ui:FluentWindow x:Class="UniShare.UI.Views.ShareEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:UniShare.UI"
        xmlns:vm="clr-namespace:UniShare.UI.ViewModels"
        Title="{Binding Title}" Height="640" Width="580"
        MinHeight="540" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <!-- 标题栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 表单内容 -->
            <RowDefinition Height="*"/>
            <!-- 底部操作栏 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：图标与标题紧贴最左侧 -->
        <Grid Grid.Row="0">
            <ui:TitleBar Title="" ShowMaximize="False" ShowMinimize="False"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False">
                <Image Source="pack://application:,,,/Assets/icon.ico" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PageBackgroundBrush}"/>

        <!-- 表单滚动区：将右侧边距拆分给内部 StackPanel，为滚动条预留独立外侧通道，避免遮挡卡片矩形框 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="20,12,4,12">
            <StackPanel Margin="0,0,16,0">
                <!-- 主区块 1：基本设置（核心必填项，视觉最突出） -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="基础信息" FontSize="14" FontWeight="Bold" Margin="0,0,0,14"/>

                        <!-- 本地文件夹 -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="本地文件夹" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" Text="{Binding LocalPath, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="选择或输入要共享的文件夹路径..."/>
                                <ui:Button Grid.Column="1" Content="浏览..." Appearance="Secondary" Padding="16,6" Margin="8,0,0,0"
                                           Command="{Binding BrowseCommand}"/>
                            </Grid>
                        </StackPanel>

                        <!-- 共享名称 -->
                        <StackPanel>
                            <TextBlock Text="共享名称" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                            <ui:TextBox Text="{Binding ShareName, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="局域网内显示的文件夹名称，例如 camera 或 media"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 主区块 2：访问权限（用户授权与匿名访问整合，主次清晰） -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="访问权限" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

                        <!-- 子项 A：账号访问 -->
                        <TextBlock Text="授权用户" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>

                        <!-- 添加用户栏 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="用户名"/>
                            <ui:PasswordBox x:Name="TxtNewPassword" Grid.Column="2" PlaceholderText="密码"/>
                            <ComboBox Grid.Column="4" SelectedIndex="{Binding NewUserAccessIndex}">
                                <ComboBoxItem Content="读写"/>
                                <ComboBoxItem Content="只读"/>
                            </ComboBox>
                            <ui:Button Grid.Column="6" Content="添加用户" Appearance="Secondary" Padding="14,6" Click="BtnAddUser_Click"/>
                        </Grid>

                        <!-- 暂无用户提示 -->
                        <Border Background="{StaticResource NeutralSubtleBrush}"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="0,0,0,10"
                                Visibility="{Binding HasUsers, Converter={x:Static local:Converters.InverseBoolToVisible}}">
                            <TextBlock Text="暂未添加用户，请添加授权用户或在下方开启匿名访问"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       FontSize="12"/>
                        </Border>

                        <!-- 已添加的用户列表 -->
                        <ItemsControl ItemsSource="{Binding Users}" Margin="0,0,0,4"
                                      Visibility="{Binding HasUsers, Converter={x:Static local:Converters.BoolToVisible}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ShareUserItem}">
                                    <Border Background="{StaticResource NeutralSubtleBrush}" CornerRadius="6" Padding="12,7" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Username}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis"/>

                                            <ComboBox Grid.Column="1" SelectedIndex="{Binding AccessLevelIndex}" Width="86" Margin="0,0,8,0">
                                                <ComboBoxItem Content="读写"/>
                                                <ComboBoxItem Content="只读"/>
                                            </ComboBox>

                                            <ui:Button Grid.Column="2" Content="移除" Appearance="Secondary" Padding="10,4" Command="{Binding RemoveCommand}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 分隔线 -->
                        <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,8,0,12"/>

                        <!-- 子项 B：匿名访问 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      Content="允许匿名访问"
                                      IsChecked="{Binding AllowGuest}"
                                      VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="匿名权限" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="86" SelectedIndex="{Binding GuestAccessIndex}" IsEnabled="{Binding AllowGuest}">
                                    <ComboBoxItem Content="读写"/>
                                    <ComboBoxItem Content="只读"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 次区块 3：协议兼容（可选高级项，置于底部弱化视觉权重） -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="协议兼容" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                        <CheckBox Content="启用 SMB 1.0 (兼容旧协议设备)" IsChecked="{Binding EnableSmb1}" Margin="0,0,0,4"/>
                        <TextBlock Text="现代协议 SMB 2.x / 3.x 已默认开启，为手机、电脑、智能电视等设备提供高速传输"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   FontSize="11"
                                   Margin="28,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="取消" Appearance="Secondary" Width="92" Height="36" Margin="0,0,10,0"
                           Command="{Binding CancelCommand}" IsCancel="True"/>
                <ui:Button Content="{Binding SaveButtonText}" Appearance="Primary" MinWidth="108" Height="36" FontWeight="SemiBold"
                           Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
